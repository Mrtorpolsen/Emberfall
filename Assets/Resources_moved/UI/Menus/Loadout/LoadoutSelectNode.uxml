<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/UI%20Toolkit/CommonStyle.uss?fileID=7433441132597879392&amp;guid=0b2b72f60fa71064ba05ca62a4a9380a&amp;type=3#CommonStyle"/>
    <Style src="project://database/Assets/Resources_moved/UI/Menus/Loadout/LoadoutSelectNodeStyle.uss?fileID=7433441132597879392&amp;guid=f49ed0fbe5bebb149bc226f83f6878ea&amp;type=3#LoadoutSelectNodeStyle"/>
    <ui:VisualElement name="LoadoutSlot" class="btnBackground1x1 loadoutSelectNodeContainer">
        <ui:VisualElement name="EmptyContainer" style="flex-grow: 1; display: flex;">
            <ui:VisualElement name="ImgContainer" style="flex-grow: 1; width: auto; padding-bottom: 0%; align-content: center; justify-content: center; aspect-ratio: 1;">
                <ui:VisualElement name="ImgEmpty" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=3316425174430470091&amp;guid=6cbaf819f3bdb324388d85c3d1e972f2&amp;type=3#check-dash@2x&quot;); margin-bottom: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="OccupiedContainer" style="flex-grow: 1; display: none;">
            <ui:Label text="Berserker" name="Label_Cost" class="text" style="align-self: center; font-size: 26px; margin-top: 0; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 4px; padding-left: 0; -unity-text-auto-size: none;"/>
            <ui:VisualElement name="ImgContainer" style="flex-grow: 1; width: auto; padding-bottom: 0%; align-content: center; justify-content: center; aspect-ratio: 1;">
                <ui:VisualElement name="ImgOccupied" class="placeholderImg" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; margin-bottom: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
